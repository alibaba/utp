{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/global-state-machine/entities/state_notify_request.json",
  "version": "2026-07-29",
  "title": "UTP State Notify Request",
  "description": "POST /utp/state/notify 的请求体",
  "type": "object",
  "properties": {
    "action_response": {
      "$ref": "../../primitives/common/action_response.json",
      "utp_request": "required"
    },
    "state_views": {
      "type": "array",
      "items": {
        "$ref": "state_view.json"
      },
      "minItems": 1,
      "utp_request": "required",
      "description": "同一个 Action Response 一次形成的完整 StateView 集合"
    }
  },
  "required": [
    "action_response",
    "state_views"
  ],
  "additionalProperties": true
}
