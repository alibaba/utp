{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/merchant/entities/aftersale_proposal_result_payload.json",
  "version": "2026-08-04",
  "title": "AftersaleProposalResultPayload",
  "description": "买方对替代方案的回应载荷。",
  "type": "object",
  "required": [
    "aftersale_id",
    "round_no",
    "buyer_response"
  ],
  "properties": {
    "aftersale_id": {
      "type": "string"
    },
    "round_no": {
      "type": "integer",
      "minimum": 1
    },
    "buyer_response": {
      "enum": [
        "accepted",
        "countered",
        "rejected"
      ],
      "description": "accepted → 方案成立进入 APPROVED；countered → 回到 REQUESTED 并递增 round_no；rejected → 售后关闭。"
    },
    "counter_resolution": {
      "$ref": "../../primitives/aftersale/entities/resolution.json",
      "description": "买方再议时提出的方案（buyer_response = countered 时 MUST 提供）。"
    },
    "note": {
      "type": "string",
      "maxLength": 512
    },
    "next_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "新一轮处置截止时间（countered 时 MUST 提供）。"
    }
  },
  "additionalProperties": true
}
