{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/merchant/events/aftersale_return_shipped_payload.json",
  "version": "2026-08-04",
  "title": "AftersaleReturnShippedPayload",
  "description": "买方退货寄出载荷。供应商据此准备收货与验货。",
  "type": "object",
  "required": [
    "aftersale_id",
    "shipped_at"
  ],
  "properties": {
    "aftersale_id": {
      "type": "string"
    },
    "carrier_code": {
      "type": "string",
      "description": "退货承运商标识。"
    },
    "tracking_no": {
      "type": "string",
      "description": "退货物流单号。"
    },
    "shipped_at": {
      "type": "string",
      "format": "date-time"
    },
    "expected_arrival": {
      "type": "string",
      "format": "date-time"
    },
    "return_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "供应商确认收货的截止时间，逾期未确认按平台规则处置。"
    }
  },
  "additionalProperties": true
}
