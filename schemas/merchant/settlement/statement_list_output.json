{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/merchant/settlement/statement_list_output.json",
  "version": "2026-07-01",
  "title": "StatementListOutput",
  "type": "object",
  "required": [
    "statements"
  ],
  "properties": {
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "账单摘要（不含 entries 全量；明细经 statement.detail 获取）。",
        "required": [
          "statement_id",
          "period",
          "version",
          "total_payable",
          "status",
          "dispute_deadline"
        ],
        "properties": {
          "statement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "period": {
            "$ref": "#/$defs/statement/properties/period"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "total_payable": {
            "$ref": "../../primitives/common/entities/money.json"
          },
          "status": {
            "$ref": "statement_status.json"
          },
          "dispute_deadline": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    },
    "pagination": {
      "$ref": "../../primitives/common/pagination.json#/$defs/response"
    },
    "valid_next_actions": {
      "$ref": "../../primitives/common/valid_next_actions.json"
    }
  },
  "additionalProperties": true
}
