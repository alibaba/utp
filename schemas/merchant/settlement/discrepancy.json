{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/merchant/settlement/discrepancy.json",
  "version": "2026-07-01",
  "title": "Discrepancy",
  "description": "SettlementDiscrepancy（M8.6.3）：结构化差异申报记录。",
  "type": "object",
  "required": [
    "discrepancy_id",
    "statement_id",
    "entry_id",
    "type",
    "expected",
    "actual",
    "evidence_refs",
    "status",
    "seller_signature",
    "submitted_at"
  ],
  "properties": {
    "discrepancy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "statement_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "entry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "entry_missing 类型时为供应商侧构造的期望条目标识。"
    },
    "type": {
      "$ref": "discrepancy_type.json"
    },
    "expected": {
      "type": "object",
      "description": "期望值（结构随 type 而定）。",
      "additionalProperties": true
    },
    "actual": {
      "type": "object",
      "description": "账单值对照。",
      "additionalProperties": true
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "description": "证据引用（ERP 单据、收货凭证等）；MUST 非空。"
    },
    "status": {
      "$ref": "discrepancy_status.json"
    },
    "resolution_note": {
      "type": "string",
      "description": "Marketplace 答复说明（ACCEPTED/MAINTAINED 时）。"
    },
    "seller_signature": {
      "$ref": "../../primitives/common/entities/signature.json"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
