{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/merchant/registration/credential_submission.json",
  "version": "2026-07-30",
  "title": "CredentialSubmission",
  "description": "资质提交/更新/换证载荷（M2.5，首次与维护同通道）。文件清单由平台按类目公示；本结构只标准化提交通道。",
  "type": "object",
  "required": [
    "idempotency_key",
    "credentials"
  ],
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "credentials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "document_uri"
        ],
        "properties": {
          "credential_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "更新/换证时引用既有条目；新提交省略。"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "资质类型标识（平台公示清单中的键）。"
          },
          "document_uri": {
            "type": "string",
            "format": "uri"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
