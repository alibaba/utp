{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/listing/entities/listing_core.json",
  "version": "2026-07-01",
  "title": "ListingCore",
  "description": "供应商可写的商品字段集合（publish/update 的载荷基底）。库存数量字段被显式禁止（正交性，M1.5）。",
  "type": "object",
  "properties": {
    "type": {
      "$ref": "listing_type.json"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "平台类目标识。"
    },
    "description": {
      "type": "string"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "类目属性键值对，键空间由类目 Schema 定义。"
    },
    "skus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "sku.json"
      }
    },
    "pricing": {
      "$ref": "pricing.json"
    },
    "fulfillment_terms": {
      "$ref": "fulfillment_terms.json"
    },
    "trade_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../../common/entities/trade_mode.json"
      }
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "media_item.json"
      }
    },
    "compliance_refs": {
      "type": "array",
      "items": {
        "$ref": "compliance_ref.json"
      }
    },
    "visibility": {
      "enum": [
        "public",
        "framework_only"
      ],
      "default": "public"
    },
    "mode_constraints": {
      "type": "object",
      "additionalProperties": true,
      "description": "（原引用 mode_range.json，本仓由 discovery/profile 或 primitives/common 承载）"
    },
    "auto_list": {
      "type": "boolean",
      "default": false
    },
    "available": false,
    "stock": false,
    "inventory": false,
    "quantity": false
  },
  "additionalProperties": true
}
