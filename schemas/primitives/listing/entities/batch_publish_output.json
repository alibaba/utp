{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch_publish_output.json",
  "version": "2026-07-01",
  "title": "BatchPublishOutput",
  "description": "批量结果：results[i] 对应 entries[i]，部分成功语义。",
  "type": "object",
  "required": [
    "results"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "异步执行时返回，用于按 batch_id 轮询。"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "listing_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "$ref": "listing_status.json"
          },
          "error": {
            "type": "object",
            "additionalProperties": true,
            "description": "（原引用 error.json，本仓由 discovery/profile 或 primitives/common 承载）"
          }
        },
        "oneOf": [
          {
            "required": [
              "listing_id",
              "status"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
