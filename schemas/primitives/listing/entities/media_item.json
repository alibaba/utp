{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/listing/entities/media_item.json",
  "version": "2026-07-01",
  "title": "MediaItem",
  "description": "ListingMedia（M3.9.5）。",
  "type": "object",
  "required": [
    "type",
    "uri"
  ],
  "properties": {
    "media_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "type": {
      "enum": [
        "image",
        "video"
      ]
    },
    "uri": {
      "type": "string",
      "format": "uri"
    },
    "sort_order": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
