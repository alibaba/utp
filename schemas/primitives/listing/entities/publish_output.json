{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "publish_output.json",
  "version": "2026-07-01",
  "title": "PublishOutput",
  "type": "object",
  "required": [
    "listing_id",
    "status",
    "version",
    "version_hash",
    "valid_next_actions"
  ],
  "properties": {
    "listing_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "$ref": "listing_status.json"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "version_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ingest_report": {
      "type": "array",
      "description": "source_materials 逐素材解析报告（含置信度，供供应商/Agent 复核，M3.9.7）。",
      "items": {
        "type": "object",
        "required": [
          "material",
          "result"
        ],
        "properties": {
          "material": {
            "type": "string",
            "description": "素材引用（URI 或字段路径）。"
          },
          "result": {
            "enum": [
              "parsed",
              "partial",
              "failed"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "valid_next_actions": {
      "$ref": "../../common/valid_next_actions.json"
    }
  },
  "additionalProperties": true
}
