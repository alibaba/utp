{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch_publish_input.json",
  "version": "2026-07-01",
  "title": "BatchPublishInput",
  "description": "批量发布（M3.7.2）：单批 ≤ 500 条，整批共享幂等键，逐条独立成败。",
  "type": "object",
  "required": [
    "idempotency_key",
    "entries"
  ],
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "listing",
          "seller_signature"
        ],
        "properties": {
          "listing": {
            "$ref": "#/$defs/publish_request/properties/listing"
          },
          "source_materials": {
            "$ref": "source_materials.json"
          },
          "seller_signature": {
            "$ref": "../../common/entities/signature.json"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
