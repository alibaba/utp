{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "query_input.json",
  "version": "2026-07-27",
  "title": "NegotiateQueryInput",
  "description": "utp.negotiate.query 的业务输入。REST 绑定下 inquiry_id 通过路径参数传递，本 Schema 同时约束其他绑定下的查询载荷。",
  "type": "object",
  "properties": {
    "inquiry_id": {
      "type": "string",
      "minLength": 1,
      "description": "要查询的询盘 ID。"
    },
    "supplier_id": {
      "type": "string",
      "minLength": 1,
      "description": "可选。按供应商过滤报价分支（L3 竞价场景）。"
    }
  },
  "required": [
    "inquiry_id"
  ],
  "additionalProperties": true
}
