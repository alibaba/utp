{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quote_output.json",
  "version": "2026-07-27",
  "title": "QuoteOutput",
  "description": "utp.negotiate.quote 的业务输出（采购方对报价回调的接收回执）。返回成功仅表示已接收，不构成对报价条款的接受；接受以 binding 操作为准。",
  "type": "object",
  "properties": {
    "quote_ref": {
      "type": "string",
      "minLength": 1,
      "description": "回显所接收报价的 quote_id。",
      "readOnly": true
    },
    "inquiry_ref": {
      "type": "string",
      "minLength": 1,
      "description": "回显关联的询盘 ID。",
      "readOnly": true
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "采购方接收报价的时间。",
      "readOnly": true
    }
  },
  "required": [
    "quote_ref",
    "received_at"
  ],
  "additionalProperties": true
}
