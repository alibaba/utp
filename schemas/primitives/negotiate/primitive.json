{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/primitives/negotiate/primitive.json",
  "name": "utp.negotiate",
  "version": "2026-07-29",
  "title": "P2 Negotiate 询盘原语定义",
  "description": "询盘原语核心定义文件。声明本版本的完整核心操作集合、各操作的业务输入/输出 Schema 与传输绑定，以及状态机定义。请求/响应统一信封见 primitives/common/action_request.json 与 action_response.json，采用两段式校验。",
  "actions": {
    "inquiry": {
      "description": "采购方提交询盘。前置条件 pricing_mode >= L1 且 Source 已完成；成功后原语状态进入 INQUIRED。",
      "input_schema": "https://ut-protocol.com/primitives/negotiate/entities/inquiry_input.json",
      "output_schema": "https://ut-protocol.com/primitives/negotiate/entities/inquiry_output.json",
      "transport_bindings": [
        { "type": "rest", "method": "POST", "path": "/utp/negotiate/inquiry" }
      ]
    },
    "quote": {
      "description": "供应商交付报价。方向为 Seller → Buyer 的异步回调；采购方返回成功仅表示已接收，不构成对报价的接受。消息真实性与完整性由传输层消息签名（RFC 9421）保证；采购方验证后还 MUST 校验报价归属：inquiry_ref 必须是本方发起的询盘，且 supplier_id 与该询盘的目标供应商一致，不匹配的报价 MUST 拒收。回调不可达时采购方通过 query 轮询兜底。",
      "direction": "seller_to_buyer",
      "input_schema": "https://ut-protocol.com/primitives/negotiate/entities/quote_input.json",
      "output_schema": "https://ut-protocol.com/primitives/negotiate/entities/quote_output.json",
      "transport_bindings": [
        { "type": "rest", "method": "POST", "path": "{callback_base}/utp/negotiate/quote" }
      ]
    },
    "counter_offer": {
      "description": "采购方基于报价提出还价：提交调整后的完整报价行结构（含数量与期望价格）供卖家逐项确认。轮次上限仅在会话锁定轮次约束的特殊场景（如改价审批、竞标）生效，普通场景不做轮次限制。",
      "input_schema": "https://ut-protocol.com/primitives/negotiate/entities/counter_offer_input.json",
      "output_schema": "https://ut-protocol.com/primitives/negotiate/entities/counter_offer_output.json",
      "transport_bindings": [
        { "type": "rest", "method": "POST", "path": "/utp/negotiate/counter-offer" }
      ]
    },
    "binding": {
      "description": "采购方确认接受指定报价并选定交易安排，生成条款绑定。授权凭据通过 mandate_chain 携带（Operation Mandate「接受报价或 counter-offer」场景），会话协商要求 Mandate 时 MUST 携带；只能选择一个报价分支。",
      "input_schema": "https://ut-protocol.com/primitives/negotiate/entities/binding_input.json",
      "output_schema": "https://ut-protocol.com/primitives/negotiate/entities/binding_output.json",
      "transport_bindings": [
        { "type": "rest", "method": "POST", "path": "/utp/negotiate/binding" }
      ]
    },
    "query": {
      "description": "查询本方可见的协商状态与授权数据。无状态影响；查询方身份 MUST 经会话鉴权，返回范围受角色、能力提供方访问策略和 L3 竞争规则限制，禁止仅凭 inquiry_id 越权访问。",
      "input_schema": "https://ut-protocol.com/primitives/negotiate/entities/query_input.json",
      "output_schema": "https://ut-protocol.com/primitives/negotiate/entities/query_output.json",
      "transport_bindings": [
        { "type": "rest", "method": "GET", "path": "/utp/negotiate/{inquiry_id}" }
      ]
    }
  },
  "state_machine": "https://ut-protocol.com/primitives/negotiate/state_machine.json"
}
