{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.json",
  "version": "2026-07-01",
  "title": "Event",
  "description": "ShipmentEvent（M7.9.3）：存档实体 = 业务载荷 + 服务端标识。只可追加，不可覆盖既有事实。",
  "allOf": [
    {
      "$ref": "event_payload.json"
    },
    {
      "type": "object",
      "required": [
        "event_id",
        "shipment_id"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "shipment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  ]
}
