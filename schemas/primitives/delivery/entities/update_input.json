{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "update_input.json",
  "version": "2026-07-01",
  "title": "UpdateInput",
  "description": "utp.delivery.update：追加履约事件（delay/exception/customs/document/correction）。event_id 由服务端生成。",
  "type": "object",
  "required": [
    "idempotency_key",
    "shipment_id",
    "event"
  ],
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "shipment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "event": {
      "$ref": "event_payload.json"
    }
  },
  "additionalProperties": true
}
