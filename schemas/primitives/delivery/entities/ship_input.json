{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ship_input.json",
  "version": "2026-07-01",
  "title": "ShipInput",
  "description": "utp.delivery.ship：提交发货凭证（M7.8.1）。幂等：对已 SHIPPED 批次返回既有凭证。",
  "type": "object",
  "required": [
    "idempotency_key",
    "transaction_id",
    "purchase_id",
    "shipment",
    "seller_signature"
  ],
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "purchase_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shipment": {
      "type": "object",
      "description": "发货凭证草稿：不含服务端生成字段（shipment_id/status/shipped_at 由服务端确立）。",
      "required": [
        "carrier_code",
        "ships_from",
        "packages"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "carrier_code": {
          "type": "string",
          "minLength": 1
        },
        "tracking_number": {
          "type": "string",
          "minLength": 1
        },
        "activation_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ships_from": {
          "type": "string",
          "minLength": 1
        },
        "estimated_delivery_at": {
          "type": "string",
          "format": "date-time"
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "package.json"
          }
        },
        "document_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "shipment_id": false,
        "status": false,
        "shipped_at": false
      },
      "additionalProperties": true,
      "if": {
        "properties": {
          "carrier_code": {
            "not": {
              "const": "self_delivery"
            }
          }
        },
        "required": [
          "carrier_code"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "tracking_number"
            ]
          },
          {
            "required": [
              "activation_ref"
            ]
          }
        ]
      }
    },
    "seller_signature": {
      "$ref": "../../common/entities/signature.json"
    }
  },
  "additionalProperties": true
}
