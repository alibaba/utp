{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/fulfill/entities/receive_output.json",
  "version": "2026-07-27",
  "title": "FulfillReceiveOutput",
  "description": "utp.fulfill.receive 的业务输出。返回收货确认凭证；幂等——批次已确认收货时返回既有凭证（FULFILL.ALREADY_RECEIVED 语义）。",
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "description": "收货凭证唯一标识。"
    },
    "order_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单标识。"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单交付批次标识，可选。"
    },
    "result": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "CONDITIONAL"
      ],
      "description": "收货结论。CONDITIONAL 表示条件接受，应提供 reason_code。"
    },
    "received_quantity": {
      "type": "integer",
      "minimum": 1,
      "description": "本次确认收货数量。"
    },
    "line_items": {
      "type": "array",
      "items": {
        "$ref": "../../common/entities/line_item.json"
      },
      "description": "本次确认收货涉及的订单行项目与数量，可选。"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "确认收货时间。"
    }
  },
  "required": [
    "receipt_id",
    "order_id",
    "result",
    "received_quantity",
    "received_at"
  ],
  "additionalProperties": true
}
