{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/primitives/fulfill/entities/leadtime_input.json",
  "version": "2026-07-27",
  "title": "FulfillLeadtimeInput",
  "description": "utp.fulfill.leadtime 的业务输入。Buyer 请求备货、运输、清关或服务激活预估；适用状态 INIT、SHIPPED、DELAYED、PARTIAL_DELIVERED，无状态影响。",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单标识。"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单交付批次标识，可选。"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PREPARATION",
          "SHIPPING",
          "CUSTOMS",
          "INSPECTION",
          "SERVICE_ACTIVATION"
        ]
      },
      "description": "可选。请求预估的阶段范围。"
    }
  },
  "required": [
    "order_id"
  ],
  "additionalProperties": true
}
