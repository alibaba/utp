{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/fulfill/entities/query_output.json",
  "version": "2026-07-27",
  "title": "FulfillQueryOutput",
  "description": "utp.fulfill.query 的业务输出。返回单笔订单的当前状态、承诺交期、履约事件、履约收据与凭证摘要；回调不可达时 Buyer 通过本操作轮询兜底。",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单标识。"
    },
    "purchase_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单所属订购标识。"
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "description": "全局事务标识。"
    },
    "current_state": {
      "type": "string",
      "enum": [
        "INIT",
        "SHIPPED",
        "DELAYED",
        "DELIVERED",
        "INSPECTED",
        "RECEIVED",
        "PARTIAL_DELIVERED",
        "FULFILLED",
        "REJECTED"
      ],
      "description": "订单当前履约状态（采购方可观测状态机）。"
    },
    "promised_delivery_date": {
      "type": "string",
      "format": "date",
      "description": "可选。承诺交货日期，来自 binding_terms.terms_snapshot.delivery，用于延迟判定。"
    },
    "last_event_at": {
      "type": "string",
      "format": "date-time",
      "description": "最近一次履约事件时间，可选。"
    },
    "batches": {
      "type": "array",
      "items": {
        "$ref": "partial_delivery.json"
      },
      "description": "订单分批交付记录。分批、阶段履约和部分验收场景 SHOULD 返回。"
    },
    "tracking_events": {
      "type": "array",
      "items": {
        "$ref": "tracking_event.json"
      },
      "description": "履约事件列表。"
    },
    "trace_info": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trace_info"
      },
      "description": "按包裹或运单聚合的物流轨迹，可选。沿用历史 UCP shopping trace_info 的分层经验，不替代 P5 状态事件。"
    },
    "inspection_summary": {
      "$ref": "#/$defs/inspection_summary",
      "description": "订单级验货摘要，可选。"
    },
    "document_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "清关单证、验货报告或服务交付文档引用，可选。"
    },
    "evidence_bundle_ref": {
      "type": "string",
      "description": "履约证据包引用，可选。"
    },
    "fulfillment_receipt": {
      "$ref": "fulfillment_receipt.json",
      "description": "订单履约收据。"
    },
    "receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "已生成的收货凭证 ID 摘要。"
    },
    "rejection_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "已生成的拒收凭证 ID 摘要。"
    }
  },
  "required": [
    "order_id",
    "purchase_id",
    "transaction_id",
    "current_state"
  ],
  "additionalProperties": true,
  "$defs": {
    "trace_info": {
      "type": "object",
      "properties": {
        "tracking_number": {
          "type": "string",
          "minLength": 1,
          "description": "运单号。"
        },
        "shipment_id": {
          "type": "string",
          "minLength": 1,
          "description": "关联发货或物流批次标识，可选。"
        },
        "carrier": {
          "type": "string",
          "description": "承运商名称，可选。"
        },
        "carrier_code": {
          "type": "string",
          "description": "承运商编码，可选。"
        },
        "tracking_url": {
          "type": "string",
          "format": "uri",
          "description": "承运商物流查询链接，可选。"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action_time": {
                "type": "string",
                "format": "date-time",
                "description": "节点发生时间。"
              },
              "node_code": {
                "type": "string",
                "description": "节点状态码，如 TRANSPORT、SIGN、PICKUP。"
              },
              "node_desc": {
                "type": "string",
                "description": "节点状态描述。"
              },
              "location": {
                "type": "string",
                "description": "节点地点，可选。"
              },
              "location_code": {
                "type": "string",
                "description": "节点地点编码，可选。"
              }
            },
            "required": [
              "action_time",
              "node_code"
            ],
            "additionalProperties": true
          },
          "description": "物流扫描节点，SHOULD 按时间升序排列。"
        }
      },
      "required": [
        "tracking_number",
        "nodes"
      ],
      "additionalProperties": true
    },
    "inspection_summary": {
      "type": "object",
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "NOT_REQUIRED",
            "PENDING",
            "PASSED",
            "FAILED",
            "CONDITIONAL"
          ],
          "description": "订单级验货状态或结论。"
        },
        "inspected_at": {
          "type": "string",
          "format": "date-time",
          "description": "验货完成时间，可选。"
        },
        "report_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "验货报告引用，可选。"
        }
      },
      "additionalProperties": true
    }
  }
}
