{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/fulfill/entities/rejection_confirmation.json",
  "version": "2026-07-27",
  "title": "RejectionConfirmation",
  "description": "采购方拒收凭证。生成后激活 Resolve 原语，作为索赔证据链的一部分；被拒批次不再进入 RECEIVED 或 FULFILLED。",
  "type": "object",
  "properties": {
    "rejection_id": {
      "type": "string",
      "minLength": 1,
      "description": "拒收凭证唯一标识。"
    },
    "order_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单标识。"
    },
    "purchase_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单所属订购标识。"
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "description": "全局事务标识。"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单交付批次标识，可选。"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "description": "结构化拒收原因码。"
    },
    "reason_detail": {
      "type": "string",
      "description": "拒收原因详情，可选。"
    },
    "line_items": {
      "type": "array",
      "items": {
        "$ref": "../../common/entities/line_item.json"
      },
      "description": "本次拒收涉及的订单行项目与数量，可选。"
    },
    "rejected_at": {
      "type": "string",
      "format": "date-time",
      "description": "拒收时间。采用 RFC 3339 date-time 格式。"
    },
    "desired_resolution": {
      "type": "string",
      "enum": [
        "REFUND",
        "REPLACEMENT",
        "REWORK",
        "PRICE_ADJUSTMENT",
        "CANCEL_REMAINING",
        "OTHER"
      ],
      "description": "采购方期望的后续处理方向，可选；实际争议处理仍由 Resolve 原语确定。"
    }
  },
  "required": [
    "rejection_id",
    "order_id",
    "purchase_id",
    "transaction_id",
    "reason_code",
    "rejected_at"
  ],
  "additionalProperties": true
}
