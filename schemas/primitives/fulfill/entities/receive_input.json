{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/fulfill/entities/receive_input.json",
  "version": "2026-07-27",
  "title": "FulfillReceiveInput",
  "description": "utp.fulfill.receive 的业务输入。Buyer 对已妥投且满足验货要求的订单/批次确认收货，MUST 携带 Buyer 签名；当前批次进入 RECEIVED，全部批次完成时进入 FULFILLED。",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单标识。"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单交付批次标识，可选。"
    },
    "line_items": {
      "type": "array",
      "items": {
        "$ref": "partial_delivery.json#/$defs/partial_delivery_line_item"
      },
      "description": "本次确认收货涉及的订单行项目与数量，可选。分批或部分收货场景 SHOULD 提供。"
    },
    "result": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "CONDITIONAL"
      ],
      "default": "ACCEPTED",
      "description": "收货结论，缺省 ACCEPTED。CONDITIONAL 表示条件接受，应提供 reason_code。"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "确认收货时间，可选。"
    }
  },
  "required": [
    "order_id",
    "received_quantity",
    "signature"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "CONDITIONAL"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "required": [
          "reason_code"
        ]
      }
    }
  ]
}
