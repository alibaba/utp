{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/primitives/fulfill/entities/reject_output.json",
  "version": "2026-07-27",
  "title": "FulfillRejectOutput",
  "description": "utp.fulfill.reject 的业务输出。返回拒收凭证；生成后激活 Resolve（后续可执行 utp.resolve.raise）；幂等——批次已拒收时返回既有凭证（FULFILL.ALREADY_REJECTED 语义）。",
  "type": "object",
  "properties": {
    "rejection_id": {
      "type": "string",
      "minLength": 1,
      "description": "拒收凭证唯一标识。"
    },
    "order_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单标识。"
    },
    "purchase_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单所属订购标识。"
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "description": "全局事务标识。"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单交付批次标识，可选。"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "description": "结构化拒收原因码。"
    },
    "reason_detail": {
      "type": "string",
      "description": "拒收原因详情，可选。"
    },
    "line_items": {
      "type": "array",
      "items": {
        "$ref": "partial_delivery.json#/$defs/partial_delivery_line_item"
      },
      "description": "本次拒收涉及的订单行项目与数量，可选。"
    },
    "rejected_at": {
      "type": "string",
      "format": "date-time",
      "description": "拒收时间。"
    },
    "desired_resolution": {
      "type": "string",
      "enum": [
        "REFUND",
        "REPLACEMENT",
        "REWORK",
        "PRICE_ADJUSTMENT",
        "CANCEL_REMAINING",
        "OTHER"
      ],
      "description": "采购方期望的后续处理方向，可选；实际争议处理仍由 Resolve 原语确定。"
    }
  },
  "required": [
    "rejection_id",
    "order_id",
    "purchase_id",
    "transaction_id",
    "reason_code",
    "rejected_at"
  ],
  "additionalProperties": true
}
