{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/fulfill/entities/partial_delivery.json",
  "version": "2026-07-30",
  "title": "PartialDelivery",
  "description": "订单分批交付摘要，记录单个批次的商品明细、交付状态、关联运单与凭证引用。",
  "type": "object",
  "required": [
    "batch_id",
    "status",
    "line_items"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单交付批次标识。"
    },
    "status": {
      "type": "string",
      "description": "批次当前的交付业务状态。"
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../../common/entities/line_item.json"
      },
      "description": "该批次计划交付的商品或服务及其数量。"
    },
    "shipments": {
      "type": "array",
      "description": "该批次关联的发货或物流单元摘要。",
      "items": {
        "$ref": "shipment.json"
      }
    },
    "estimated_delivery_time": {
      "$ref": "../../common/entities/time_value.json",
      "description": "该批次当前的预计交付时效。"
    },
    "promised_delivery_time": {
      "$ref": "../../common/entities/time_value.json",
      "description": "下单或合同确认时承诺的批次交付时效。"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "该批次实际全部妥投时间。采用 RFC 3339 date-time 格式。"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "买家对该批次实际确认收货的时间。采用 RFC 3339 date-time 格式。"
    },
    "inspection": {
      "$ref": "#/$defs/inspection_summary",
      "description": "批次验货摘要，可选。"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "inspection_summary": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "inspection_id": {
          "type": "string",
          "minLength": 1,
          "description": "验货记录标识，可选。"
        },
        "result": {
          "type": "string",
          "enum": [
            "PASSED",
            "FAILED",
            "CONDITIONAL"
          ],
          "description": "验货结论。"
        },
        "inspected_at": {
          "type": "string",
          "format": "date-time",
          "description": "验货完成时间，可选。采用 RFC 3339 date-time 格式。"
        }
      },
      "additionalProperties": true
    }
  }
}
