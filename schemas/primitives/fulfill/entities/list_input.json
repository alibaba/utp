{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/fulfill/entities/list_input.json",
  "version": "2026-07-27",
  "title": "FulfillListInput",
  "description": "utp.fulfill.list 的业务输入。Buyer 检索与自身关联的订单摘要，支持结构化筛选、排序与分页；所有筛选条件均可选。",
  "type": "object",
  "properties": {
    // 过滤条件 ==》 ucp
    "filters": {
      "type": "object",
      "properties": {
        "order_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "可选。按订单 ID 集合筛选。"
        },
        "purchase_id": {
          "type": "string",
          "minLength": 1,
          "description": "可选。按订购标识筛选。"
        },
        "transaction_id": {
          "type": "string",
          "minLength": 1,
          "description": "可选。按全局事务标识筛选。"
        },
        "status": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
            // 订单的状态， 不是原语里的动作状态
            ]
          },
         // "description": "可选。按履约状态筛选。"
        },
        "supplier_id": {
          "type": "string",
          "minLength": 1,
          "description": "可选。按供应商筛选。"
        },
        "time_range": {
          "$ref": "#/$defs/time_range",
          "description": "可选。按最近创建订单时间范围筛选。"
        },
        "keyword": {
          "type": "string",
          "description": "按购买关键词筛选，模糊匹配订单中任一行项目的商品名称。"
        }
      },
      "additionalProperties": true,
      "description": "结构化筛选条件。"
    },
    "sort_by": {
      "type": "string",
      "enum": [
        "created_at"
      ],
      "description": "排序字段。默认 created_at。"
    },
    "sort_order": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ],
      "description": "排序方向。默认 desc。"
    },
    "pagination": {
      "$ref": "../../../common/pagination.json#/$defs/request",
      "description": "游标分页参数。"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "time_range": {
      "type": "object",
      "properties": {
        "from": {
          // RFC 339 ==> 标准化
          "type": "string",
          "format": "date-time",
          "description": "起始时间（含）。"
        },
        "to": {
          "type": "string",
          "format": "date-time",
          "description": "结束时间（含）。"
        }
      },
      "additionalProperties": true
    },
    "date_range": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date",
          "description": "起始日期（含）。"
        },
        "to": {
          "type": "string",
          "format": "date",
          "description": "结束日期（含）。"
        }
      },
      "additionalProperties": true
    }
  }
}
