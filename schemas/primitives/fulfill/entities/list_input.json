{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/fulfill/entities/list_input.json",
  "version": "2026-07-31",
  "title": "FulfillListInput",
  "description": "订单履约列表的筛选、排序与分页条件。多个筛选条件之间采用 AND 逻辑。",
  "type": "object",
  "properties": {
    "filters": {
      "$ref": "#/$defs/filters",
      "description": "订单履约列表的筛选条件。"
    },
    "sort_by": {
      "type": "string",
      "enum": [
        "created_at",
        "amount"
      ],
      "description": "排序字段。"
    },
    "sort_order": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ],
      "default": "desc",
      "description": "排序方向，默认为 desc。"
    },
    "pagination": {
      "$ref": "../../../common/pagination.json#/$defs/request",
      "description": "游标分页参数。"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "filters": {
      "type": "object",
      "description": "订单履约筛选条件。status 数组内部采用 OR 逻辑，其余条件之间采用 AND 逻辑。",
      "properties": {
        "order_id": {
          "type": "string",
          "minLength": 1,
          "description": "按订单标识精确筛选。"
        },
        "purchase_id": {
          "type": "string",
          "minLength": 1,
          "description": "按订购标识筛选其关联的订单。"
        },
        "transaction_id": {
          "type": "string",
          "minLength": 1,
          "description": "按交易会话标识筛选其关联的订单。"
        },
        "supplier_id": {
          "type": "string",
          "minLength": 1,
          "description": "按履行订单的供应商筛选。"
        },
        "status": {
          "type": "array",
          "description": "按一个或多个履约状态筛选。",
          "items": {
            "type": "string",
            "enum": [
              "INIT",
              "SHIPPED",
              "DELAYED",
              "DELIVERED",
              "INSPECTED",
              "RECEIVED",
              "PARTIAL_DELIVERED",
              "FULFILLED",
              "REJECTED"
            ]
          }
        },
        "keyword": {
          "type": "string",
          "description": "按订单中商品或服务的展示名称进行模糊筛选。"
        },
        "created_after": {
          "type": "string",
          "format": "date-time",
          "description": "筛选在该时间之后创建的订单。"
        },
        "created_before": {
          "type": "string",
          "format": "date-time",
          "description": "筛选在该时间之前创建的订单。"
        }
      },
      "additionalProperties": true
    }
  }
}
