{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/primitives/fulfill/entities/fulfillment_receipt.json",
  "version": "2026-07-27",
  "title": "FulfillmentReceipt",
  "description": "订单履约收据，P5 后置条件的核心产出物，汇总累计已交付、已收、拒收数量、分批记录、总体结论与证据包引用。",
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "description": "履约收据唯一标识。"
    },
    "order_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单标识。"
    },
    "purchase_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单所属订购标识。"
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "description": "全局事务标识。"
    },
    "total_received_quantity": {
      "type": "integer",
      "minimum": 0,
      "description": "累计已收数量。"
    },
    "total_delivered_quantity": {
      "type": "integer",
      "minimum": 0,
      "description": "累计已交付数量，可选。"
    },
    "total_rejected_quantity": {
      "type": "integer",
      "minimum": 0,
      "description": "累计已拒收数量，可选。"
    },
    "batches": {
      "type": "array",
      "items": {
        "$ref": "partial_delivery.json"
      },
      "description": "分批交付记录，可选。"
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "PARTIAL",
        "FULFILLED",
        "REJECTED"
      ],
      "description": "总体结论。"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "履约完成时间，可选。"
    },
    "evidence_bundle_ref": {
      "type": "string",
      "description": "证据包引用，可选。"
    },
    "receipt_confirmation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "关联收货凭证 ID 列表，可选。"
    },
    "rejection_confirmation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "关联拒收凭证 ID 列表，可选。"
    }
  },
  "required": [
    "receipt_id",
    "order_id",
    "purchase_id",
    "transaction_id",
    "total_received_quantity"
  ],
  "additionalProperties": true
}
