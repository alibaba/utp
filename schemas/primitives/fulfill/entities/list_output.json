{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/fulfill/entities/list_output.json",
  "version": "2026-07-31",
  "title": "FulfillListOutput",
  "description": "符合查询条件的订单履约列表及分页信息。空列表表示没有匹配订单。",
  "type": "object",
  "required": [
    "orders"
  ],
  "properties": {
    "orders": {
      "type": "array",
      "description": "订单及其当前履约信息列表。",
      "items": {
        "$ref": "order_fulfillment.json"
      }
    },
    "pagination": {
      "$ref": "../../common/pagination.json#/$defs/response",
      "description": "游标分页信息。"
    }
  },
  "additionalProperties": true
}
