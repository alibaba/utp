{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/fulfill/entities/shipment.json",
  "version": "2026-07-31",
  "title": "Shipment",
  "description": "交付批次中的一个实际发货或物流单元。",
  "type": "object",
  "required": [
    "shipment_id",
    "line_items"
  ],
  "properties": {
    "shipment_id": {
      "type": "string",
      "minLength": 1,
      "description": "发货或物流单元标识。"
    },
    "tracking_number": {
      "type": "string",
      "minLength": 1,
      "description": "承运商分配的物流单号。"
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "description": "该发货或物流单元承载的商品或服务及其数量。",
      "items": {
        "$ref": "../../common/entities/line_item.json"
      }
    }
  },
  "additionalProperties": true
}
