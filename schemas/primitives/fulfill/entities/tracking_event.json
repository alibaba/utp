{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/fulfill/entities/tracking_event.json",
  "version": "2026-07-27",
  "title": "TrackingEvent",
  "description": "订单履约事件，Seller 经 notify 推送。order_id 为直接履约锚点；物流单、包裹、运单号和外部报告为可选关联资源，不作为履约锚点。",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "事件唯一标识，用于通知幂等去重——Schema 首版增强字段。推荐所有实现携带以支持幂等去重，暂不强制以保持与规范 §15.9.1 字段表兼容。"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "FULFILLMENT_STATUS",
        "LOGISTICS_TRACE",
        "CUSTOMS",
        "INSPECTION",
        "SERVICE_ACTIVATION",
        "EXCEPTION"
      ],
      "description": "事件类型，可选。用于区分协议履约节点、物流扫描节点、清关、验货、服务激活和异常事实。"
    },
    "order_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单标识，履约锚点。"
    },
    "purchase_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单所属订购标识；一次订购可关联多笔订单。notify SHOULD 携带。"
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "description": "全局事务标识。notify SHOULD 携带。"
    },
    "shipment_id": {
      "type": "string",
      "minLength": 1,
      "description": "可选，履约单标识。"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "description": "订单交付批次标识，可选。"
    },
    "tracking_number": {
      "type": "string",
      "minLength": 1,
      "description": "承运商物流单号，可选。"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "事件发生时间。"
    },
    "status": {
      "type": "string",
      "enum": [
        "SHIPPED",
        "IN_TRANSIT",
        "DELAYED",
        "DELIVERED",
        "INSPECTED",
        "INSPECTION_FAILED",
        "CUSTOMS_HOLD",
        "CUSTOMS_CLEARED",
        "OUT_FOR_DELIVERY",
        "DELIVERY_ATTEMPT_FAILED",
        "RETURNED_TO_SENDER",
        "SERVICE_ACTIVATED"
      ],
      "description": "事件状态。SHIPPED、DELAYED、DELIVERED、INSPECTED 可驱动 P5 可观测状态迁移；其他状态作为履约事实记录，默认不直接改变 P5 状态。"
    },
    "state_effect": {
      "type": "string",
      "enum": [
        "NO_STATE_CHANGE",
        "SHIPPED",
        "DELAYED",
        "DELIVERED",
        "INSPECTED"
      ],
      "description": "事件处理后对 P5 可观测状态的影响，可选。未提供时由 status 与状态机规则推导。"
    },
    "location": {
      "type": "string",
      "description": "事件发生地点，可选。"
    },
    "description": {
      "type": "string",
      "description": "事件描述，可选。"
    },
    "carrier": {
      "type": "string",
      "description": "承运商名称，可选。"
    },
    "carrier_code": {
      "type": "string",
      "description": "承运商编码，可选。"
    },
    "tracking_url": {
      "type": "string",
      "format": "uri",
      "description": "承运商物流查询链接，可选。"
    },
    "line_items": {
      "type": "array",
      "items": {
        "$ref": "partial_delivery.json#/$defs/partial_delivery_line_item"
      },
      "description": "本事件涉及的订单行项目与数量，可选。"
    },
    "document_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "清关单证、验货报告或其他履约文档引用，可选。"
    }
  },
  "required": [
    "order_id",
    "timestamp",
    "status"
  ],
  // 减少 推送状态
  "additionalProperties": true
}
