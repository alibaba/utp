{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/fulfill/entities/status_event.json",
  "version": "2026-07-31",
  "title": "StatusEvent",
  "description": "业务对象的一次状态变化记录。",
  "type": "object",
  "required": [
    "status",
    "occurred_at"
  ],
  "properties": {
    "status": {
      "type": "string",
      "minLength": 1,
      "description": "变化后的业务状态。"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "该状态变化实际发生的时间。"
    },
    "description": {
      "type": "string",
      "description": "状态变化的可读说明。"
    }
  },
  "additionalProperties": true
}
