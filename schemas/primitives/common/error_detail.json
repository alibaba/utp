{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/common/error_detail.json",
  "version": "2026-07-27",
  "title": "UTP Error Detail",
  "description": "UTP 标准错误响应中的结构化错误内容。",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "description": "遵循 UTP 错误码格式的结构化错误码。"
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "description": "错误严重度：error 表示失败；warning 表示可继续但需关注；info 表示提示。"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "description": "人类可读的错误描述。"
    },
    "details": {
      "type": "object",
      "description": "错误的附加上下文。",
      "additionalProperties": true
    },
    "retryable": {
      "type": "boolean",
      "description": "该错误是否可通过重试解决。"
    },
    "retry_after": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "建议重试等待秒数。"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "description": "原始请求的标识，用于问题追踪。"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "错误发生时间，使用 ISO 8601 UTC 表示。"
    }
  },
  "required": [
    "code",
    "severity",
    "message",
    "retryable",
    "request_id",
    "timestamp"
  ],
  "additionalProperties": true
}
