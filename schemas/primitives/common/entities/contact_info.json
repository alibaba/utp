{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/common/entities/contact_info.json",
  "version": "2026-07-30",
  "title": "ContactInfo",
  "description": "自然人或组织的联系信息。",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "联系人名称。"
    },
    "phone": {
      "type": "string",
      "description": "联系电话。"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "联系邮箱。"
    },
    "role": {
      "type": "string",
      "description": "联系人在当前业务中的职责。"
    }
  },
  "additionalProperties": true
}
