{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/common/entities/money.json",
  "version": "2026-07-27",
  "title": "Money",
  "description": "货币金额。amount 使用 decimal 字符串表达，避免浮点精度问题；精度由货币决定（CNY 精确到分）。",
  "type": "object",
  "required": [
    "amount",
    "currency"
  ],
  "properties": {
    "amount": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d{1,4})?$",
      "description": "金额数值的 decimal 字符串，如 \"1280.00\"。"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "货币代码，遵循 ISO 4217，如 \"CNY\"、\"USD\"。"
    }
  },
  "additionalProperties": true
}
