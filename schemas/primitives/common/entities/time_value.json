{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/common/entities/time_value.json",
  "version": "2026-07-31",
  "title": "TimeValue",
  "description": "由相对自然日时长和对应绝对日期时间组成的时间值。",
  "type": "object",
  "properties": {
    "days": {
      "type": "integer",
      "minimum": 0,
      "description": "相对时长，单位为自然日。"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "对应的绝对日期时间，使用 RFC 3339 格式。"
    }
  },
  "required": [
    "days",
    "date"
  ],
  "additionalProperties": true
}
