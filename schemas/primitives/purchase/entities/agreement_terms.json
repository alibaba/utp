{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/purchase/entities/agreement_terms.json",
  "version": "2026-07-29",
  "title": "AgreementTerms",
  "description": "采购合同或框架协议的结构化条款快照。",
  "type": "object",
  "required": [
    "terms"
  ],
  "properties": {
    "binding_terms_ref": {
      "type": "string",
      "description": "已绑定询盘条款引用。"
    },
    "effective_period": {
      "$ref": "../../common/entities/time_range.json",
      "description": "协议的生效时间区间。"
    },
    "terms_document_ref": {
      "$ref": "../../common/entities/document_reference.json",
      "description": "可选的协议正文或附件引用。"
    },
    "terms": {
      "description": "采购合同或框架协议的专有条款。",
      "oneOf": [
        {
          "$ref": "purchase_contract_terms.json"
        },
        {
          "$ref": "framework_agreement_terms.json"
        }
      ]
    }
  },
  "additionalProperties": true
}
