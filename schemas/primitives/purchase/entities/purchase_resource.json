{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/purchase/entities/purchase_resource.json",
  "version": "2026-07-29",
  "title": "PurchaseResource",
  "description": "查询或取消订单、采购合同或框架协议后返回的 Purchase 资源。",
  "type": "object",
  "required": [
    "object_type"
  ],
  "properties": {
    "object_type": {
      "type": "string",
      "enum": [
        "order",
        "agreement"
      ],
      "description": "Purchase 资源类型。"
    },
    "purchase_order": {
      "$ref": "purchase_order.json",
      "description": "订单聚合。"
    },
    "purchase_agreement": {
      "$ref": "purchase_agreement.json",
      "description": "采购合同或框架协议聚合。"
    }
  },
  "if": {
    "properties": {
      "object_type": {
        "const": "order"
      }
    }
  },
  "then": {
    "required": [
      "purchase_order"
    ],
    "not": {
      "required": [
        "purchase_agreement"
      ]
    }
  },
  "else": {
    "required": [
      "purchase_agreement"
    ],
    "not": {
      "required": [
        "purchase_order"
      ]
    }
  },
  "additionalProperties": true
}
