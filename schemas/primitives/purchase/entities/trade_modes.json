{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/primitives/purchase/entities/trade_modes.json",
  "version": "2026-07-30",
  "title": "TradeModes",
  "description": "商家支持的业务交易模式集合及买方当前选择。",
  "type": "object",
  "required": [
    "available_modes"
  ],
  "properties": {
    "available_modes": {
      "type": "array",
      "minItems": 1,
      "description": "商家支持并允许买方选择的业务交易模式。",
      "readOnly": true,
      "items": {
        "$ref": "../../common/entities/trade_mode.json"
      }
    },
    "selected_mode": {
      "type": "string",
      "description": "买方选择的业务交易模式标识，对应 available_modes 中某个模式的 id。"
    }
  },
  "additionalProperties": true
}
