{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/purchase/entities/purchase_agreement.json",
  "version": "2026-07-29",
  "title": "PurchaseAgreement",
  "description": "采购合同或框架协议聚合。",
  "type": "object",
  "required": [
    "purchase_id",
    "agreement_type",
    "state"
  ],
  "properties": {
    "purchase_id": {
      "type": "string",
      "description": "Purchase 原语内采购合同或框架协议的唯一资源标识。",
      "readOnly": true
    },
    "agreement_type": {
      "type": "string",
      "description": "协议形态：采购合同或框架协议。",
      "enum": [
        "purchase_contract",
        "framework_agreement"
      ],
      "utp_request": {
        "contract-create": "required",
        "contract-update": "omit",
        "contract-complete": "omit"
      }
    },
    "state": {
      "type": "string",
      "description": "协议聚合的持久化状态。",
      "readOnly": true
    },
    "binding_terms_ref": {
      "type": "string",
      "description": "已绑定询盘条款引用。",
      "utp_request": {
        "contract-create": "optional",
        "contract-update": "optional",
        "contract-complete": "omit"
      }
    },
    "effective_period": {
      "$ref": "../../common/entities/time_range.json",
      "description": "协议的生效时间区间。",
      "utp_request": {
        "contract-create": "optional",
        "contract-update": "optional",
        "contract-complete": "omit"
      }
    },
    "terms_document_ref": {
      "$ref": "../../common/entities/document_reference.json",
      "description": "可选的协议正文或附件引用。",
      "utp_request": {
        "contract-create": "optional",
        "contract-update": "optional",
        "contract-complete": "omit"
      }
    }
  },
  "additionalProperties": true
}
