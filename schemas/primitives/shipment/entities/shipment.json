{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipment.json",
  "version": "2026-07-01",
  "title": "Shipment",
  "description": "Shipment 发货凭证（M7.9.1）。carrier_code ≠ self_delivery 时 tracking_number 必填；虚拟交付以激活凭证替代（M7.6）。",
  "type": "object",
  "required": [
    "shipment_id",
    "transaction_id",
    "purchase_id",
    "status",
    "carrier_code",
    "packages",
    "ships_from",
    "shipped_at",
    "seller_signature"
  ],
  "properties": {
    "shipment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "purchase_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "批次标识；分批交付时必填（由 split_plan 预登记）。"
    },
    "status": {
      "$ref": "shipment_status.json"
    },
    "carrier_code": {
      "type": "string",
      "minLength": 1,
      "description": "承运商标识（标准码表或 self_delivery）。"
    },
    "tracking_number": {
      "type": "string",
      "minLength": 1
    },
    "activation_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "服务/虚拟商品的激活凭证引用（替代物流运单）。"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "package.json"
      }
    },
    "ships_from": {
      "type": "string",
      "minLength": 1
    },
    "estimated_delivery_at": {
      "type": "string",
      "format": "date-time"
    },
    "shipped_at": {
      "type": "string",
      "format": "date-time"
    },
    "document_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "description": "单证引用（发货单、报关单、原产地证）；compliance_level ≥ L2 时按要求必附。"
    },
    "seller_signature": {
      "$ref": "../../common/entities/signature.json",
      "description": "覆盖 shipment_hash：对 {transaction_id, batch_id, carrier_code, tracking_number, packages, ships_from, shipped_at}（缺省字段省略键）按 RFC 8785/JCS 规范化后的 SHA-256 十六进制小写串（M7.9.1，统一规则见 M1.10）。"
    }
  },
  "additionalProperties": true,
  "if": {
    "properties": {
      "carrier_code": {
        "not": {
          "const": "self_delivery"
        }
      }
    },
    "required": [
      "carrier_code"
    ]
  },
  "then": {
    "anyOf": [
      {
        "required": [
          "tracking_number"
        ]
      },
      {
        "required": [
          "activation_ref"
        ]
      }
    ]
  }
}
