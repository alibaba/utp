{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/aftersale/entities/return_receipt.json",
  "version": "2026-08-04",
  "title": "ReturnReceipt",
  "description": "退货收货与验货结论。Marketplace 据此决定退款金额。",
  "type": "object",
  "required": [
    "received_at",
    "inspection_result"
  ],
  "properties": {
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "实际收货时间。"
    },
    "received_lines": {
      "type": "array",
      "minItems": 1,
      "description": "涉及的订单行与数量。",
      "items": {
        "type": "object",
        "required": [
          "line_no",
          "quantity"
        ],
        "properties": {
          "line_no": {
            "type": "integer",
            "minimum": 1,
            "description": "订单行号，MUST 与订购条款快照一致。"
          },
          "sku_id": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "涉及数量，MUST NOT 超过该行已交付数量。"
          },
          "note": {
            "type": "string",
            "maxLength": 256
          }
        },
        "additionalProperties": true
      }
    },
    "inspection_result": {
      "$ref": "inspection_result.json"
    },
    "accepted_amount": {
      "$ref": "../../common/entities/money.json",
      "description": "验货后认可的退款金额（inspection_result = partial 时 MUST 提供）。"
    },
    "discrepancy_note": {
      "type": "string",
      "maxLength": 1024,
      "description": "差异说明（结果非 pass 时 MUST 提供）。"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "../../common/entities/evidence_reference.json"
      },
      "description": "验货举证（开箱照片、检测记录）。"
    },
    "inspector": {
      "enum": [
        "human",
        "agent",
        "policy_auto"
      ],
      "description": "验货结论的产生方式。"
    }
  },
  "additionalProperties": true
}
