{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/aftersale/entities/list_input.json",
  "version": "2026-08-04",
  "title": "ListInput",
  "description": "utp.aftersale.list：筛选售后单，游标分页。用于待处理队列拉取与推送丢失时的轮询降级。",
  "type": "object",
  "required": [],
  "properties": {
    "status": {
      "type": "array",
      "items": {
        "$ref": "aftersale_status.json"
      },
      "description": "按状态过滤。缺省返回全部非终态售后单。"
    },
    "aftersale_type": {
      "type": "array",
      "items": {
        "$ref": "aftersale_type.json"
      }
    },
    "purchase_id": {
      "type": "string",
      "description": "按关联订购过滤。"
    },
    "created_after": {
      "type": "string",
      "format": "date-time"
    },
    "created_before": {
      "type": "string",
      "format": "date-time"
    },
    "deadline_before": {
      "type": "string",
      "format": "date-time",
      "description": "按处置截止时间过滤，用于优先处理临期任务。"
    },
    "pagination": {
      "$ref": "../../common/pagination.json"
    }
  },
  "additionalProperties": true
}
