{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch_write_input.json",
  "version": "2026-07-01",
  "title": "BatchWriteInput",
  "description": "批量 set/adjust（M4.8.2）：单批 ≤ 500 条，逐条独立成败；异步执行时响应返回 batch_id，按 M3.7.2 规则轮询。",
  "type": "object",
  "required": [
    "idempotency_key",
    "entries"
  ],
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "op",
              "payload"
            ],
            "properties": {
              "op": {
                "const": "set"
              },
              "payload": {
                "$ref": "set_payload.json"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "op",
              "payload"
            ],
            "properties": {
              "op": {
                "const": "adjust"
              },
              "payload": {
                "$ref": "adjust_payload.json"
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
