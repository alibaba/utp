{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/resolve/entities/compensate_output.json",
  "version": "2026-07-31",
  "title": "ResolveCompensateOutput",
  "description": "补偿执行后的争议档案和可选资金退款结果。",
  "type": "object",
  "required": [
    "dispute_record"
  ],
  "properties": {
    "dispute_record": {
      "$ref": "dispute_record.json",
      "description": "包含补偿执行结果和最新状态的争议权威档案。"
    },
    "refund_result": {
      "$ref": "../../pay/entities/refund_result.json",
      "description": "补偿包含资金退款时由 utp.pay.refund 返回的标准结果。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dispute_record": {
            "description": "用于判断本次补偿是否包含退款指令的权威争议档案。",
            "properties": {
              "resolution_outcome": {
                "description": "本次补偿所执行的权威处置结果。",
                "properties": {
                  "instructions": {
                    "description": "用于识别资金退款动作的处置指令列表。",
                    "contains": {
                      "type": "object",
                      "properties": {
                        "instruction_type": { "const": "refund", "description": "待执行或已执行的退款指令。" }
                      },
                      "required": ["instruction_type"]
                    }
                  }
                },
                "required": ["instructions"]
              }
            },
            "required": ["resolution_outcome"]
          }
        },
        "required": ["dispute_record"]
      },
      "then": {
        "required": ["refund_result"]
      }
    }
  ],
  "additionalProperties": true
}
