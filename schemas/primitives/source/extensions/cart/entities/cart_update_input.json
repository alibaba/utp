{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/source/extensions/cart/entities/cart_update_input.json",
  "version": "2026-07-29",
  "title": "CartUpdateInput",
  "description": "utp.source_cart.update 的业务输入。quantity 和 selected 至少提供一个。",
  "type": "object",
  "properties": {
    "cart_ref": {
      "$ref": "./cart_ref.json",
      "writeOnly": true,
      "description": "需要修改商品项的购物车引用。"
    },
    "cart_item_id": {
      "type": "string",
      "minLength": 1,
      "description": "最近一次 Cart Query 返回的购物车项标识。",
      "writeOnly": true
    },
    "query_token": {
      "type": "string",
      "minLength": 1,
      "description": "最近一次 Cart Query 返回的短期令牌。",
      "writeOnly": true
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "description": "调用方看到的购物车版本；不匹配时返回 VERSION_CONFLICT。",
      "writeOnly": true
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "description": "新的商品数量。",
      "writeOnly": true
    },
    "selected": {
      "type": "boolean",
      "description": "新的选中状态。",
      "writeOnly": true
    }
  },
  "required": [
    "cart_item_id",
    "query_token",
    "expected_version"
  ],
  "anyOf": [
    {
      "required": [
        "quantity"
      ]
    },
    {
      "required": [
        "selected"
      ]
    }
  ],
  "additionalProperties": true
}
