{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/source/entities/supplier_credentials.json",
  "version": "2026-07-29",
  "title": "SupplierCredentials",
  "description": "Lookup 详情使用的供应商完整资质、经营背景和审计引用。",
  "type": "object",
  "$defs": {
    "certification": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "认证类型，如 ISO9001、CE、FDA 或 UL。",
          "readOnly": true
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "description": "签发机构名称。",
          "readOnly": true
        },
        "certificate_number": {
          "type": "string",
          "minLength": 1,
          "description": "证书编号。",
          "readOnly": true
        },
        "issued_at": {
          "type": "string",
          "format": "date",
          "description": "签发日期。",
          "readOnly": true
        },
        "expires_at": {
          "type": "string",
          "format": "date",
          "description": "到期日期；是否仍有效由业务层按当前时间校验。",
          "readOnly": true
        },
        "verification_url": {
          "type": "string",
          "format": "uri",
          "description": "在线验证证书的 URL。",
          "readOnly": true
        },
        "scope": {
          "type": "string",
          "description": "认证覆盖范围。",
          "readOnly": true
        }
      },
      "required": [
        "type",
        "issuer",
        "certificate_number",
        "issued_at",
        "expires_at"
      ],
      "additionalProperties": true
    }
  },
  "properties": {
    "certifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/certification"
      },
      "description": "认证证书列表。",
      "readOnly": true
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "basic",
        "silver",
        "gold",
        "platinum"
      ],
      "description": "平台验证等级。",
      "readOnly": true
    },
    "years_in_business": {
      "type": "integer",
      "minimum": 0,
      "description": "经营年限。",
      "readOnly": true
    },
    "annual_revenue_range": {
      "type": "string",
      "description": "年营收范围的人类可读描述。",
      "readOnly": true
    },
    "factory_size_sqm": {
      "type": "integer",
      "minimum": 0,
      "description": "兼容既有 UCP-B 数据的厂房面积，单位平方米。",
      "readOnly": true
    },
    "production_lines": {
      "type": "integer",
      "minimum": 1,
      "description": "兼容既有 UCP-B 数据的生产线数量。",
      "readOnly": true
    },
    "main_export_markets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "uniqueItems": true,
      "description": "主要出口市场，使用 ISO 3166-1 alpha-2 代码。",
      "readOnly": true
    },
    "verified_supplier": {
      "type": "boolean",
      "description": "是否通过平台或第三方实地核验。",
      "readOnly": true
    },
    "audit_report_ref": {
      "type": "string",
      "minLength": 1,
      "description": "审计报告引用；compliance_level >= L3 时由业务层要求必填。",
      "readOnly": true
    }
  },
  "required": [
    "certifications",
    "verification_level"
  ],
  "additionalProperties": true
}
