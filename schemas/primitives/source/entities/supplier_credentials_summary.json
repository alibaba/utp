{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/source/entities/supplier_credentials_summary.json",
  "version": "2026-07-29",
  "title": "SupplierCredentialsSummary",
  "description": "搜索候选列表使用的供应商资质摘要；完整证书信息由 Lookup 的 SupplierCredentials 返回。",
  "type": "object",
  "properties": {
    "certifications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "认证类型名称列表。",
      "readOnly": true
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "basic",
        "silver",
        "gold",
        "platinum"
      ],
      "description": "平台验证等级。",
      "readOnly": true
    },
    "on_time_delivery_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "历史准时交货率。",
      "readOnly": true
    },
    "years_in_business": {
      "type": "integer",
      "minimum": 0,
      "description": "经营年限。",
      "readOnly": true
    },
    "verified_supplier": {
      "type": "boolean",
      "description": "是否通过平台或第三方实地核验。",
      "readOnly": true
    }
  },
  "required": [
    "certifications",
    "verification_level"
  ],
  "additionalProperties": true
}
