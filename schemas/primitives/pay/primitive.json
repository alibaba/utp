{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/pay/primitive.json",
  "name": "utp.pay",
  "version": "2026-07-31",
  "title": "P4 Pay 原语定义",
  "description": "定义支付授权、渠道确认、分阶段付款、状态查询和退款执行；争议裁决由 P6 Resolve 产生退款指令后调用本原语执行。",
  "actions": {
    "initiate": {
      "description": "Payer 基于 Purchase 聚合和令牌化支付工具发起支付授权，PaymentProcessor 返回包含协议支付请求标识与当前状态的聚合。",
      "initiator_role": "Payer",
      "handler_role": "PaymentProcessor",
      "data_visibility": "V2",
      "input_schema": {
        "$ref": "entities/payment_request.json"
      },
      "output_schema": {
        "$ref": "entities/payment_request.json"
      },
      "transport_bindings": [
        { "type": "rest", "method": "POST", "path": "/utp/v1/payments" },
        { "type": "mcp", "tool": "utp.pay.initiate" },
        { "type": "a2a", "action": "utp.pay.initiate" }
      ]
    },
    "confirm": {
      "description": "Payer 或协议引擎提交支付渠道事实，PaymentProcessor 验签并返回处理中、已确认或失败状态；仅确认成功时签发 PaymentConfirmation。",
      "initiator_role": "Payer",
      "handler_role": "PaymentProcessor",
      "data_visibility": "V2",
      "input_schema": {
        "$ref": "entities/confirm_input.json"
      },
      "output_schema": {
        "$ref": "entities/payment_execution_result.json"
      },
      "transport_bindings": [
        { "type": "rest", "method": "POST", "path": "/utp/v1/payments/{payment_request_id}/confirm" },
        { "type": "mcp", "tool": "utp.pay.confirm" },
        { "type": "a2a", "action": "utp.pay.confirm" }
      ]
    },
    "term": {
      "description": "Payer 在结构化履约条件满足后执行一个付款阶段，PaymentProcessor 返回当前处理状态与累计进度；仅确认成功时签发 PaymentConfirmation。",
      "initiator_role": "Payer",
      "handler_role": "PaymentProcessor",
      "data_visibility": "V2",
      "input_schema": {
        "$ref": "entities/term_input.json"
      },
      "output_schema": {
        "allOf": [
          { "$ref": "entities/payment_execution_result.json" },
          {
            "type": "object",
            "required": ["payment_progress"]
          }
        ]
      },
      "transport_bindings": [
        { "type": "rest", "method": "POST", "path": "/utp/v1/payments/terms" },
        { "type": "mcp", "tool": "utp.pay.term" },
        { "type": "a2a", "action": "utp.pay.term" }
      ]
    },
    "query": {
      "description": "Payer 只读查询单笔支付或 Purchase 下全部付款阶段的协议侧状态快照，不产生资金或状态副作用。",
      "initiator_role": "Payer",
      "handler_role": "PaymentProcessor",
      "data_visibility": "V2",
      "input_schema": {
        "$ref": "entities/query_input.json"
      },
      "output_schema": {
        "$ref": "entities/query_output.json"
      },
      "transport_bindings": [
        { "type": "rest", "method": "POST", "path": "/utp/v1/payments/query" },
        { "type": "mcp", "tool": "utp.pay.query" },
        { "type": "a2a", "action": "utp.pay.query" }
      ]
    },
    "refund": {
      "description": "Arbiter 代表已授权的 Resolve 或 Saga 处置请求退款，PaymentProcessor 执行后返回渠道退款结果；Buyer 与 Seller 不得直接调用。",
      "initiator_role": "Arbiter",
      "handler_role": "PaymentProcessor",
      "data_visibility": "V2",
      "input_schema": {
        "$ref": "entities/refund_instruction.json"
      },
      "output_schema": {
        "$ref": "entities/refund_result.json"
      },
      "transport_bindings": [
        { "type": "rest", "method": "POST", "path": "/utp/v1/payments/refunds" },
        { "type": "mcp", "tool": "utp.pay.refund" },
        { "type": "a2a", "action": "utp.pay.refund" }
      ]
    }
  },
  "state_machine": {
    "initial_state": "INIT",
    "states": {
      "INIT": { "description": "尚未发起支付；Purchase 聚合与支付授权上下文已经就绪。" },
      "AUTHORIZED": { "description": "支付工具已授权或资金已预冻结，可继续确认支付或执行付款阶段。" },
      "PROCESSING": { "description": "支付正在渠道侧处理中，等待签名回调或权威查询结果。" },
      "CONFIRMED": { "description": "当前支付或付款阶段已确认到账。" },
      "PARTIAL": { "description": "至少一个付款阶段已完成，但仍有未完成阶段。" },
      "COMPLETED": { "description": "全部付款义务已完成，仅允许查询或经授权执行退款。" },
      "FAILED": { "description": "支付最终失败；补偿处理后可重新发起，或进入 Resolve。" },
      "COMPENSATED": { "description": "退款或授权解除等补偿已完成，可按交易规则重新发起支付。" }
    },
    "transitions": [
      { "from": "INIT", "action": "utp.pay.initiate", "to": "AUTHORIZED" },
      { "from": "AUTHORIZED", "action": "utp.pay.confirm", "to": "PROCESSING" },
      { "from": "AUTHORIZED", "action": "utp.pay.term", "to": "PROCESSING" },
      { "from": "AUTHORIZED", "action": "utp.pay.confirm", "to": "CONFIRMED", "condition": "同步返回 PAYMENT_CAPTURED" },
      { "from": "AUTHORIZED", "action": "utp.pay.confirm", "to": "FAILED", "condition": "同步返回 PAYMENT_FAILED" },
      { "from": "AUTHORIZED", "action": "utp.pay.term", "to": "CONFIRMED", "condition": "同步返回 PAYMENT_CAPTURED" },
      { "from": "AUTHORIZED", "action": "utp.pay.term", "to": "FAILED", "condition": "同步返回 PAYMENT_FAILED" },
      { "from": "PROCESSING", "event": "PAYMENT_CAPTURED", "to": "CONFIRMED" },
      { "from": "PROCESSING", "event": "PAYMENT_FAILED", "to": "FAILED" },
      { "from": "CONFIRMED", "event": "REMAINING_TERMS_DETECTED", "to": "PARTIAL" },
      { "from": "CONFIRMED", "event": "ALL_TERMS_COMPLETED", "to": "COMPLETED" },
      { "from": "PARTIAL", "action": "utp.pay.term", "to": "PROCESSING" },
      { "from": "PARTIAL", "action": "utp.pay.term", "to": "CONFIRMED", "condition": "同步返回 PAYMENT_CAPTURED" },
      { "from": "PARTIAL", "action": "utp.pay.term", "to": "FAILED", "condition": "同步返回 PAYMENT_FAILED" },
      { "from": "FAILED", "event": "COMPENSATION_COMPLETED", "to": "COMPENSATED" },
      { "from": "COMPENSATED", "action": "utp.pay.initiate", "to": "AUTHORIZED", "condition": "交易规则仍允许重试" },
      { "from": "CONFIRMED", "action": "utp.pay.refund", "to": "COMPENSATED", "condition": "退款已完成且覆盖当前已确认金额" },
      { "from": "CONFIRMED", "action": "utp.pay.refund", "to": "CONFIRMED", "condition": "退款已完成、仅覆盖部分金额且当前付款义务仍然有效" },
      { "from": "PARTIAL", "action": "utp.pay.refund", "to": "COMPENSATED", "condition": "退款已完成且终止剩余付款义务" },
      { "from": "PARTIAL", "action": "utp.pay.refund", "to": "PARTIAL", "condition": "退款已完成、仅覆盖部分金额且仍有后续付款义务" },
      { "from": "COMPLETED", "action": "utp.pay.refund", "to": "COMPENSATED", "condition": "Resolve 或 Saga 授权的全额终止性退款已完成" },
      { "from": "COMPLETED", "action": "utp.pay.refund", "to": "COMPLETED", "condition": "Resolve 或 Saga 授权的部分退款已完成且剩余支付事实仍有效" }
    ],
    "constraints": {
      "notes": [
        "utp.pay.query 在所有状态均为只读操作，不触发状态迁移。",
        "除 query 外的 Pay Action 必须在统一请求信封中携带 transaction_id 与 idempotency_key；query 必须携带 transaction_id。",
        "支付渠道原始状态必须先通过 PaymentAdapterContract 映射为标准 PaymentEvent。",
        "一个交易可产生多个渠道流水，但所有 Pay Action 必须使用统一请求信封中的 transaction_id 关联交易。",
        "PaymentRequest.amount 必须等于 AmountBreakdown 计算结果，SettlementInstruction.splits 金额合计必须等于本次支付金额，且所有金额币种必须一致。",
        "PaymentProgress.total_amount 必须等于 paid_amount 与 remaining_amount 之和，completed_terms 不得包含重复阶段；存在剩余付款义务时 next_term 必须对应尚未完成的阶段。",
        "支付授权必须动态绑定本次金额与收款方；支付工具令牌、Mandate 和委托凭证不得出现在响应或日志中。",
        "退款金额不得超过原支付可退余额；只有退款完成时才产生 PAYMENT_REFUNDED 事件并迁移 Pay 状态，processing 或 failed 必须保持原支付事实状态且不得伪造完成事件。"
      ]
    }
  }
}
