{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/pay/entities/term_output.json",
  "version": "2026-07-31",
  "title": "PayTermOutput",
  "description": "单个付款阶段执行后的当前状态、累计进度，以及按状态返回的确认凭证和标准事件。",
  "type": "object",
  "required": [
    "status",
    "payment_progress"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["processing", "confirmed", "failed"],
      "description": "本付款阶段的执行状态：processing 仍在处理；confirmed 已确认；failed 最终失败。"
    },
    "payment_confirmation": {
      "$ref": "payment_confirmation.json",
      "description": "本付款阶段的支付确认凭证。"
    },
    "payment_progress": {
      "$ref": "payment_progress.json",
      "description": "包含本阶段结果的累计付款进度。"
    },
    "payment_event": {
      "$ref": "payment_event.json",
      "description": "本阶段执行产生的标准支付事件。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "confirmed", "description": "付款阶段已确认成功。" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["payment_confirmation", "payment_event"],
        "properties": {
          "payment_event": {
            "description": "付款阶段成功时产生的标准捕获事件。",
            "properties": {
              "event_type": { "const": "PAYMENT_CAPTURED", "description": "付款阶段成功必须产生捕获事件。" }
            },
            "required": ["event_type"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "failed", "description": "付款阶段已最终失败。" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["payment_event"],
        "properties": {
          "payment_event": {
            "description": "付款阶段失败时产生的标准失败事件。",
            "properties": {
              "event_type": { "const": "PAYMENT_FAILED", "description": "付款阶段失败必须产生失败事件。" }
            },
            "required": ["event_type"]
          }
        },
        "not": { "required": ["payment_confirmation"] }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "processing", "description": "付款阶段仍在渠道处理中。" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "payment_event": {
            "description": "付款阶段处理中可选回显的既有授权事件。",
            "properties": {
              "event_type": { "const": "PAYMENT_AUTHORIZED", "description": "处理中若返回事件，只能回显既有授权事实。" }
            },
            "required": ["event_type"]
          }
        },
        "not": { "required": ["payment_confirmation"] }
      }
    }
  ],
  "additionalProperties": true
}
