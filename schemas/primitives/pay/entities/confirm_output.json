{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ut-protocol.com/schemas/primitives/pay/entities/confirm_output.json",
  "version": "2026-07-31",
  "title": "PayConfirmOutput",
  "description": "支付渠道确认尝试的当前状态，以及按状态返回的支付确认、累计进度和标准事件。",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["processing", "confirmed", "failed"],
      "description": "本次渠道确认后的状态：processing 仍在处理；confirmed 已确认；failed 最终失败。"
    },
    "payment_confirmation": {
      "$ref": "payment_confirmation.json",
      "description": "渠道事实验证通过后签发的支付确认凭证。"
    },
    "payment_progress": {
      "$ref": "payment_progress.json",
      "description": "多阶段付款场景中的累计支付进度。"
    },
    "payment_event": {
      "$ref": "payment_event.json",
      "description": "本次确认产生的标准支付事件。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "confirmed", "description": "渠道已确认扣付成功。" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["payment_confirmation", "payment_event"],
        "properties": {
          "payment_event": {
            "description": "确认成功时产生的标准捕获事件。",
            "properties": {
              "event_type": { "const": "PAYMENT_CAPTURED", "description": "确认成功必须产生捕获事件。" }
            },
            "required": ["event_type"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "failed", "description": "渠道已返回最终失败。" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["payment_event"],
        "properties": {
          "payment_event": {
            "description": "确认失败时产生的标准失败事件。",
            "properties": {
              "event_type": { "const": "PAYMENT_FAILED", "description": "最终失败必须产生失败事件。" }
            },
            "required": ["event_type"]
          }
        },
        "not": { "required": ["payment_confirmation"] }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "processing", "description": "渠道仍在处理中。" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "payment_event": {
            "description": "处理中可选回显的既有授权事件。",
            "properties": {
              "event_type": { "const": "PAYMENT_AUTHORIZED", "description": "处理中若返回事件，只能回显既有授权事实。" }
            },
            "required": ["event_type"]
          }
        },
        "not": { "required": ["payment_confirmation"] }
      }
    }
  ],
  "additionalProperties": true
}
