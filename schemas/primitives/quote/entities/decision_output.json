{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision_output.json",
  "version": "2026-07-30",
  "title": "DecisionOutput",
  "description": "写操作标准响应（含 valid_next_actions 自描述，M1.10）。",
  "type": "object",
  "required": [
    "record_id",
    "status",
    "round_no",
    "version",
    "valid_next_actions"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "status": {
      "$ref": "quote_status.json"
    },
    "round_no": {
      "type": "integer"
    },
    "version": {
      "type": "integer"
    },
    "valid_next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
